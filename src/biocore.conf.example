{
    "listen": {
        "unix_socket": "/tmp/biocore.sock",
        "tcp_host": "0.0.0.0",
        "tcp_port": 6789
    },
    "simulation": {
        "default_dt": 0.1,
        "default_mode": 0,
        "consolidation_interval": 10000,
        "plugins_path": "/usr/lib/biocore/plugins/",
        "gpu_enabled": false
    },
    "logging": {
        "log_file": "/var/log/biocore.log",
        "log_level": "info",
        "log_max_size_mb": 10,
        "log_max_files": 5
    }
}
